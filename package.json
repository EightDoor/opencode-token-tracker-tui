{
  "name": "opencode-token-tracker-tui",
  "version": "2.1.0",
  "description": "Token usage and cost tracking for OpenCode 2 with a compact TUI sidebar summary",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "token",
    "usage",
    "cost",
    "tracking",
    "ai",
    "llm",
    "claude",
    "gpt",
    "anthropic",
    "openai"
  ],
  "author": "EightDoor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightDoor/opencode-token-tracker-tui.git"
  },
  "bugs": {
    "url": "https://github.com/EightDoor/opencode-token-tracker-tui/issues"
  },
  "homepage": "https://github.com/EightDoor/opencode-token-tracker-tui#readme",
  "dependencies": {
    "@opencode/plugin": "^2.0.18"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "^20.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lib",
    "dist/tui",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}